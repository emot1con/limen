APP_ENV=development
APP_PORT=8000
LOG_LEVEL=info

POSTGRES_DB=limen
POSTGRES_USER=postgres
POSTGRES_PASSWORD=psql
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
POSTGRES_RETRY_ATTEMPTS=5
POSTGRES_SSLMODE=disable
POSTGRES_RETRY_MAX_BACKOFF=10s
POSTGRES_RETRY_INITIAL_BACKOFF=1s

REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_PASSWORD=
REDIS_DB=0
REDIS_RETRY_ATTEMPTS=5
REDIS_RETRY_INITIAL_BACKOFF=1s
REDIS_RETRY_MAX_BACKOFF=10s

FINGERPRINT_SERVICE_URL=http://localhost:5001
FINGERPRINT_API_KEY=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

CACHE_ENABLED=true
CACHE_KEY_PREFIX=limen:cache
CACHE_TTL_SCHOOL_SETTINGS=1h
CACHE_TTL_PASSING_GRADES=12h
CACHE_TTL_ACADEMIC=20m
CACHE_TTL_SCHEDULES=20m
CACHE_TTL_QUIZ=10m

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=limen-api

LOKI_ENABLED=false
LOKI_URL=http://localhost:3100
